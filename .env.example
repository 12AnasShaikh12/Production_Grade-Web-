# =============================================================================
# Amros Beauty — environment configuration (PLACEHOLDERS ONLY — never commit real values)
# Copy to .env.local for development. Every integration is optional: when a value is missing the
# related feature degrades safely (see README → "What works without configuration").
# Only NEXT_PUBLIC_* values are exposed to the browser — never put secrets in them.
# =============================================================================

# --- Application -------------------------------------------------------------
# Public origin used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# development | preview | production | test. Defaults from NODE_ENV.
# NEVER set "development" on a public deployment (it enables the local admin password login).
APP_ENV=development

# --- NVIDIA AI (chat + embeddings) — server only -------------------------------
# Create a key at https://build.nvidia.com (API key starts with "nvapi-").
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Model IDs must exist in the catalog for your key — check with `npm run nvidia:smoke`
# or Admin → Dashboard → "Verify NVIDIA models". Both IDs below were listed in the public
# catalog (GET /v1/models) on 2026-10-25; availability can change.
NVIDIA_CHAT_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v1
# "query_passage" sends input_type=query|passage (NVIDIA retrieval embedders); "none" omits it.
NVIDIA_EMBEDDING_INPUT_TYPE=query_passage
NVIDIA_TIMEOUT_MS=15000
NVIDIA_MAX_RETRIES=1

# --- Retrieval tuning ----------------------------------------------------------
# Minimum cosine similarity for a vector hit to count as evidence (0–1).
RAG_MIN_SIMILARITY=0.32
# Minimum BM25 score for a keyword hit to count as evidence.
RAG_MIN_LEXICAL_SCORE=2
RAG_TOP_K=6

# --- Supabase (database, pgvector, admin auth) — server only ------------------
# Project Settings → API. The anon (public) key is only used server-side for admin sign-in.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key bypasses RLS — server only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin access ---------------------------------------------------------------
# Comma-separated staff emails allowed into /admin (in addition to rows in public.admin_users).
ADMIN_EMAILS=
# Development-only password login (ignored when APP_ENV/NODE_ENV is production).
ADMIN_LOCAL_PASSWORD=
# 32+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
ADMIN_SESSION_SECRET=

# Local JSON content store for development edits: auto | enabled | disabled
LOCAL_CONTENT_STORE=auto
LOCAL_CONTENT_PATH=.data/content.json

# --- Payments: Razorpay — server only ------------------------------------------
# Dashboard → Account & Settings → API Keys. Use test keys (rzp_test_…) until launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks (events: payment.captured, order.paid) → secret.
RAZORPAY_WEBHOOK_SECRET=
# Must be "true" (plus keys, Supabase, approved policies and shipping config) for live payments.
CHECKOUT_LIVE_PAYMENTS=false

# --- Abuse protection -------------------------------------------------------------
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_MAX_MESSAGE_CHARS=500
FORM_RATE_LIMIT_MAX=5

# --- Contact form email delivery (optional, via Resend) ---------------------------
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
